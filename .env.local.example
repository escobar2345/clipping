# Apify — used to fetch the YouTube video, transcript, scenes, and metadata
APIFY_TOKEN=your_apify_token_here

# The Apify Actor ID you want to run for YouTube scraping/transcript extraction.
# Pick one from https://apify.com/store (e.g. a "Youtube Transcript Scraper" or
# "Youtube Scraper" actor) and paste its actor ID here (just the ID, e.g.
# streamers~youtube-scraper — NOT a full URL). There are several good ones on
# the store — this is left configurable because the right actor depends on
# whether you also want comments/views/chapters, not just transcript+video.
APIFY_YOUTUBE_ACTOR_ID=your_actor_id_here

# --- Apify video DOWNLOADER (fetches the actual video file) -------------------
# When these are set, the video FILE itself is downloaded through an Apify
# video-downloader actor (not yt-dlp) — for YouTube AND any other site. Pick a
# downloader actor from the Apify Store and paste its actor ID (the ID only,
# e.g. convertfleetdotonline~youtube-downloader — NOT a full URL). If unset or
# if the run fails, the app automatically falls back to yt-dlp, so leaving these
# blank is safe.
#   YouTube:  boztek-ltd~youtube-downloader
#   Any site: klzzixjdksonskaplaif~video-downloader
# APIFY_VIDEO_DOWNLOADER_ACTOR_ID=boztek-ltd~youtube-downloader
# APIFY_YOUTUBE_DOWNLOADER_ACTOR_ID=
# APIFY_GENERAL_DOWNLOADER_ACTOR_ID=
# APIFY_DOWNLOADER_ACTOR_ID=

# NVIDIA build.nvidia.com — OpenAI-compatible endpoint that serves DeepSeek / GLM models
NVIDIA_API_KEY=your_nvidia_build_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model slug as listed on build.nvidia.com for the model you have access to
# (edit-plan + style extraction use this). Examples: deepseek-ai/deepseek-v4-pro-0813,
# zai-org/glm-4.6.
NVIDIA_GLM_MODEL=deepseek-ai/deepseek-v4-pro-0813
# OPTIONAL — chat copilot model (lib/chat.ts); defaults to z-ai/glm-5.3
NVIDIA_CHAT_MODEL=z-ai/glm-5.3

# Optional: a vision-capable model ID from build.nvidia.com, used only when
# style-profile extraction is called with useVision=true. Check the current
# catalog at build.nvidia.com/models — examples as of writing include
# meta/llama-3.2-11b-vision-instruct and nvidia/llama-3.1-nemotron-nano-vl-8b-v1,
# but confirm on the model's own page since the catalog changes.
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Buffer — posts rendered clips out to connected social channels.
# Create a personal API key at https://buffer.com (Settings → API) — Bearer
# token, no OAuth app registration needed for personal use.
BUFFER_ACCESS_TOKEN=your_buffer_personal_api_key_here
# Optional: long2short auto-detects your organization from the token via
# Buffer's `account` query. Set this only if one key reaches multiple Buffer
# organizations and you want to pin a specific one.
BUFFER_ORGANIZATION_ID=your_buffer_organization_id_here

# OPTIONAL: Apify actor used by the caption coach to search the web for
# trending topics/hashtags around your clip's subject. Defaults to the official
# "apify/google-search-scraper" if unset — only change this if you prefer a
# different SERP actor from the Apify Store.
APIFY_SEARCH_ACTOR_ID=apify/google-search-scraper

# Your app's publicly reachable URL. Buffer fetches the rendered .mp4 from
# this URL — it must stay reachable until the post actually publishes, since
# Buffer has no direct file-upload endpoint.
# ===========================================================================
# ACCOUNTS + BILLING (app-owned auth + Paystack)
# ===========================================================================
# Auth is plain Postgres: `users` / `sessions` tables with bcrypt password
# hashes (see db/schema.sql). Tables are created automatically on boot
# (instrumentation.ts → lib/dbInit.ts), or run db/schema.sql once by hand.
#
# Primary connection string — Railway's Postgres addon injects this
# automatically when attached. SSL is enabled automatically for Railway /
# managed hosts (see lib/db.ts).
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Local alternative to DATABASE_URL (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=long2short
# PGPOOL_MAX=10
# PGSSL=0                      # set to 1 to force SSL

# Paystack: dashboard.paystack.com → Settings → API Keys.
# Use the TEST secret key while testing — same code path, no real money moves.
# Docs: https://paystack.com/docs/payments/accept-payments/
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# Optional: a Paystack plan code to attach to the transaction.
# PAYSTACK_PLAN_CODE=

# Paystack redirects the browser back here after checkout. Must be your real
# public origin in production (not localhost) or the redirect will fail.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ngrok authtoken — used by the automatic tunnel during local posting.
# Create a free account and copy your token from
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Optional: a STATIC domain reserved in your ngrok dashboard (one free per
# account — dashboard.ngrok.com → Domains). With this set, every run reuses
# the same public URL instead of a new random one. Best for scheduled Buffer
# posts, since the URL Buffer saved keeps working across app restarts.
# NGROK_DOMAIN=your-reserved-name.ngrok-free.dev
# Optional: full path to the ngrok binary if it's not on PATH
# NGROK_PATH=C:\Tools\ngrok.exe

# NOTE on multiple Buffer accounts: add each extra account (name + access token
# + org ID) through the app's UI — they are stored server-side in
# data/accounts.json. The env vars above only act as a fallback "Default"
# account while no accounts are saved through the UI.


# --- Captions (optional, free) -----------------------------------------------
# By default captions are rebuilt from the transcript's real word timings.
# Set to 0 to use the model's own caption text instead.
# CAPTIONS_FROM_TRANSCRIPT=1
#
#
# Deepgram speech-to-text. Deepgram handles ALL speech-to-text when a key is set:
#   - transcript for the AI when a video has no captions (uploads, local files)
#   - word-accurate captions on every rendered clip
# Sign up at deepgram.com — new accounts get free credit and no card is needed.
# Leave the key unset to disable (platform captions are used instead).
# DEEPGRAM_API_KEY=your_key_here
# DEEPGRAM_MODEL=nova-3
# Language code if not English, e.g. es, fr, de (unset = English)
# DEEPGRAM_LANGUAGE=
# always   = Deepgram handles everything (default)
# fallback = only when a video has NO captions at all (uses the least credit)
# off      = disabled
# DEEPGRAM_MODE=always

# --- Editing (all free, no API needed) ---------------------------------------
# Tighten clips: cut long pauses and filler words ("um", "uh") out of the middle
# of each clip. On by default; only cuts when word timings are exact.
# TIGHTEN_CLIPS=1
# Smart reframing: follow the speaker's face when turning a wide video into
# 9:16, instead of always keeping the middle. On by default; falls back to the
# centred crop whenever no face is reliably found.
# SMART_REFRAME=1

# --- Voice Studio (Voice over + voice cloning via chatterbox) ----------------
# The Voice Studio calls a small local Python bridge (voice-server/voice_server.py)
# that wraps the chatterbox-master TTS library. By default the Next.js app
# AUTO-STARTS that bridge for you whenever you open the Voice Studio tab — no
# env vars needed. These knobs only matter for custom setups:

# Point at an externally hosted bridge (e.g. run voice_server.py as its own
# Railway/Fly service) instead of auto-starting one locally.
# VOICE_SERVER_URL=http://127.0.0.1:8788
# Which python executable to use when auto-starting the bridge
# (default: python3 on unix, python on Windows).
# VOICE_PYTHON=python
# Local bridge port (default 8788).
# VOICE_PORT=8788
# Set to "0" to disable auto-start (you start `python voice-server/voice_server.py`
# yourself).
# VOICE_AUTO_START=1

# --- YouTube anti-bot (renders of YouTube sources) ----------------------------
# YouTube flags cloud/datacenter IPs (Railway!) and demands "Sign in to confirm
# you're not a bot". Two layers handle this:
#
# 1) PO-token server (automatic): npm ci vendors the bgutil yt-dlp plugin +
#    its token server (vendor/bgutil-ytdlp-pot-provider) and the app boots it
#    on 127.0.0.1:4416 at startup. No config needed. Rebuild manually with
#    `npm run install:pot`. POT_SERVER_ENABLED=0 skips spawning it.
#
# 2) Cookies (the GUARANTEED fix on datacenter IPs): while logged into YouTube
#    in YOUR browser, export cookies with an extension like "Get cookies.txt
#    LOCALLY", then paste the file's full contents below (Railway env vars
#    accept multi-line values). Never commit a real cookies file — these are
#    your Google session.
# YTDLP_COOKIES=
# ...or point at a cookies file already on disk instead of pasting contents:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# Optional: route yt-dlp through a proxy as an alternative to cookies.
# YTDLP_PROXY=


# --- Media binaries (ffmpeg / ffprobe) ----------------------------------------
# Usually unnecessary: ffmpeg + ffprobe are resolved automatically from PATH,
# then nix profiles + /nix/store (Railway), then winget/scoop/chocolatey
# (Windows) and Homebrew/MacPorts//usr (unix). Set these ONLY when the binaries
# live somewhere unusual — they override everything else. `GET /api/health`
# shows which path resolved (binaries.ffmpeg / binaries.ffprobe).
# FFMPEG_PATH=/full/path/to/ffmpeg
# FFPROBE_PATH=/full/path/to/ffprobe

